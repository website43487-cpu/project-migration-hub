# Environment variables for self-hosting (Vercel / any Node host)
# Copy to .env for local dev, or add each of these in Vercel → Project Settings → Environment Variables.
# NEVER commit real values to git.

# --- Your personal Supabase project (data lives here) ---
# Supabase dashboard → Project Settings → Data API
PERSONAL_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase dashboard → Project Settings → API Keys → anon public key
PERSONAL_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Supabase dashboard → Project Settings → API Keys → service_role key (secret!)
PERSONAL_SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Staff sessions ---
# Any strong random string, e.g. run: openssl rand -hex 32
STAFF_SESSION_SECRET=

# --- Lovable-managed Supabase (auth + legacy tables; only needed while the app
# still uses the managed backend for sign-in / auth-middleware) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram order alerts (self-hosted: raw bot token) ---
# From @BotFather → /mybots → API token
TELEGRAM_BOT_TOKEN=
# Your personal chat id with the bot (message the bot, then read getUpdates)
TELEGRAM_CHAT_ID=

# --- Lovable-only (leave empty when self-hosting on Vercel) ---
LOVABLE_API_KEY=
TELEGRAM_API_KEY=
LOVABLE_CRON_SECRET=
